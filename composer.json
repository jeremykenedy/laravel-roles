{
    "name": "jeremykenedy/laravel-roles",
    "description": "A Powerful package for handling roles and permissions in Laravel. Supports Laravel 5.3 up to 13.",
    "keywords": [
        "laravel-roles",
        "laravel-permissions",
        "laravel-levels",
        "roles",
        "permissions",
        "acl",
        "levels",
        "laravel"
    ],
    "license": "MIT",
    "type": "package",
    "authors": [
        {
            "name": "Jeremy Kenedy",
            "email": "jeremykenedy@gmail.com"
        }
    ],
    "require": {
        "php": "^7.2|^8.0",
        "laravel/framework": "5.3.*|5.4.*|5.5.*|5.6.*|5.7.*|5.8.*|6.*|7.*|8.*|^9.0|^10.0|^11.0|^12.0|^13.0",
        "laravel/helpers": "^1.7"
    },
    "require-dev": {
        "jeremykenedy/laravel-seedster": "^1.0|^2.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0"
    },
    "suggest": {
        "jeremykenedy/laravel-seedster": "Required for the roles.defaultSeeds options to auto-register the package seeders with db:seed.",
        "jeremykenedy/laravel-ui-kit": "Set roles.uiKit.enabled to true to follow the CSS framework already configured for the UI kit."
    },
    "autoload": {
        "psr-4": {
            "jeremykenedy\\LaravelRoles\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "jeremykenedy\\LaravelRoles\\Test\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "jeremykenedy\\LaravelRoles\\RolesServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "fix": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
